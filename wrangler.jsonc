{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "transcript-studio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "transcript-studio",
    "database_id": "c3f5733f-01e8-4ca6-951c-e425308a7510",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{
    "binding": "MEDIA",
    "bucket_name": "transcript-studio-private"
  }],
  "queues": {
    "producers": [{ "binding": "TASKS", "queue": "transcript-studio-tasks" }],
    "consumers": [{
      "queue": "transcript-studio-tasks",
      "max_batch_size": 1,
      "max_batch_timeout": 1,
      "max_concurrency": 1,
      "max_retries": 3,
      "dead_letter_queue": "transcript-studio-dead"
    }]
  },
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "APP_ENV": "production",
    "PUBLIC_ORIGIN": "https://transcript-studio.transcript-studio.workers.dev",
    "MAX_ACTIVE_JOBS": "2",
    "DAILY_BUDGET_CENTS": "0",
    "SUPADATA_CREDIT_CENTS": "1",
    "TRANSCRIPTION_PROVIDER": "doubao",
    "LOCAL_ASR_TEST_ENABLED": "false",
    "DOUBAO_RESOURCE_ID": "volc.seedasr.auc",
    "DOUBAO_BUDGET_CENTS_PER_MINUTE": "2",
    "BILLING_ENABLED": "false",
    "CREEM_MODE": "test",
    "SUPPORT_EMAIL": "",
    "TRANSCRIPTION_ENABLED": "false",
    "LLM_DAILY_BUDGET_CENTS": "0",
    "LLM_USER_DAILY_BUDGET_CENTS": "0",
    "LLM_REQUEST_BUDGET_CENTS": "0"
  },
  "observability": { "enabled": true }
}
